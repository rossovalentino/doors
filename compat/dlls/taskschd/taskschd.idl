// Doors' Task Scheduler type library (taskschd.dll): the types, member names,
// DISPIDs and signatures Windows 11's TaskScheduler 1.0 library has, as
// tests/fixtures/windows-com/tschedprobe.c and oleautprobe's dump read them.
import "oaidl.idl";
import "ocidl.idl";

[uuid(E34CB9F1-C7F7-424C-BE29-027DCC09363A), version(1.0)]
library TaskScheduler
{
