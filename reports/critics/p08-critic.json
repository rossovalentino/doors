  "findings": [
    {
      "id": "P08-C01",
      "severity": "high",
      "title": "Forced session stop could block forever reacquiring a foreign mutex",
      "files": [
        "kernel/src/execution.rs",
        "kernel/src/task/wait.rs"
      ],
      "failure": "The old forced-stop path used ordinary cancel_wait. A condition waiter had to reacquire its mutex even after cancellation; a live unrelated owner could retain it indefinitely, preventing the victim's kernel continuation and process retirement.",
      "reproduction": "Independent scheduler probe kept the victim blocked for 20,000 ticks after cancellation while the foreign mutex owner remained live.",
      "resolution": "A privileged terminal-stop abort directly finishes the wait and resumes only kernel cleanup. Ordinary condition cancellation still reacquires the mutex.",
      "validation": "Independent none/signal/timeout/cancel orderings retire with foreign mutex ownership preserved. Actual RESTART guest logoff holds the transferred mutex in init until the victim process exits -13.",
      "status": "fixed"
    },
    {
      "id": "P08-C02",
      "severity": "high",
      "title": "Untrusted console output could create trusted serial evidence lines",
      "files": [
        "boot/debug/src/lib.rs",
        "kernel/src/platform_device.rs"
      ],
      "failure": "Console text was appended after DOOR_CONSOLE without escaping line boundaries or terminating partial writes. Ordinary user ConsoleRPC could inject fake DOOR_P08 PROCESS / DOOR_USER records or absorb a later trusted line.",
      "reproduction": "Independent LF/CR injection creates trusted-looking lines with the old formatter. The actual SAVE application submits forged kernel/user lines and a partial write.",
      "resolution": "Every console serial record is independently newline terminated, length labelled, and debug quoted with controls escaped; framebuffer content is unchanged.",
      "validation": "Independent injection probe confirms no new trusted lines and no partial-write concatenation; strict actual SAVE guest parsing accepts only the genuine kernel-attributed records.",
      "status": "fixed"
    },
    {
      "id": "P08-C03",
      "severity": "high",
      "title": "Thread completion could signal an event already retired by concurrent cleanup",
      "files": [
        "kernel/src/process/platform.rs"
      ],
      "failure": "Reaper completed a Thread and released its runtime lease before signalling its event. Last user-handle closure made the event retireable; IRQ restoration admitted another task's cleanup_waits before signal_event, producing InvalidObject and a kernel panic.",
      "reproduction": "Independent Executive/Scheduler interleaving reproduces event retirement before signalling for last-handle closure both before and after completion publication.",
      "resolution": "Reaper carries the runtime Thread lease through completion-event signalling and releases it afterward.",
      "validation": "Independent interleavings now retain the event until after signal and reclaim exactly once. Actual RESTART workload closes its worker Thread handle before condition wait and forced session revocation.",
      "status": "fixed"
    },
    {
      "id": "P08-C04",
      "severity": "high",
      "title": "Session revocation could miss a process still being constructed",
      "files": [
        "kernel/src/executive/platform.rs",
        "kernel/src/process/platform.rs"
      ],
      "failure": "Executive session binding preceded runtime Process/Task publication. Revocation in the VM construction gap enumerated the child but stop_process found no runtime record; subsequent publication launched the revoked child without a terminal stop request.",
      "reproduction": "Independent Executive lifecycle probe showed revoked construction could still publish its completion event before the fix. Source review established the missing runtime-record stop window.",
      "resolution": "set_process_wait validates current authority inside the same metadata commit that installs runtime records. A pre-publication revocation rolls back; later revocation sees even a not-yet-started task.",
      "validation": "Independent before/after publication orderings reject or enumerate correctly and fully reclaim failed-launch resources. Related StopRequests hardening validates scheduler task generation atomically with stop publication; 8,192 independent stop/start/reuse cycles reject 24,573 stale snapshots without erasing a live stop.",
      "status": "fixed"
    }
  ],
